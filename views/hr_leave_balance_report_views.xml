<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Search View -->
    <record id="view_hr_leave_balance_report_search" model="ir.ui.view">
        <field name="name">hr.leave.balance.report.search</field>
        <field name="model">hr.leave.balance.report</field>
        <field name="arch" type="xml">
            <search string="Search Leave Balances">
                <field name="employee_id" string="Employee"/>
                <field name="department_id" string="Department"/>
                <field name="holiday_status_id" string="Time Off Type"/>
                <field name="job_id" string="Job Position"/>
                
                <separator/>
                <filter string="Active Employees" name="filter_active" domain="[('active_employee', '=', True)]"/>
                <filter string="Has Remaining Balance" name="filter_positive_balance" domain="[('remaining_days', '&gt;', 0)]"/>
                <filter string="Zero or Negative Balance" name="filter_zero_or_negative" domain="[('remaining_days', '&lt;=', 0)]"/>
                <filter string="Has Taken Leaves" name="filter_has_taken" domain="[('taken_days', '&gt;', 0)]"/>
                <filter string="Has Pending Requests" name="filter_has_pending" domain="[('pending_days', '&gt;', 0)]"/>
                
                <group expand="1" string="Group By">
                    <filter string="Department" name="group_department" context="{'group_by': 'department_id'}"/>
                    <filter string="Employee" name="group_employee" context="{'group_by': 'employee_id'}"/>
                    <filter string="Time Off Type" name="group_type" context="{'group_by': 'holiday_status_id'}"/>
                    <filter string="Job Position" name="group_job" context="{'group_by': 'job_id'}"/>
                    <filter string="Company" name="group_company" context="{'group_by': 'company_id'}" groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <!-- List / Tree View -->
    <record id="view_hr_leave_balance_report_list" model="ir.ui.view">
        <field name="name">hr.leave.balance.report.list</field>
        <field name="model">hr.leave.balance.report</field>
        <field name="arch" type="xml">
            <list string="Employee Leave Balances" create="0" delete="0" edit="0" sample="1">
                <field name="employee_id" widget="many2one_avatar_employee"/>
                <field name="department_id"/>
                <field name="job_id" optional="hide"/>
                <field name="holiday_status_id" widget="badge"/>
                <field name="request_unit" optional="hide"/>
                <field name="allocated_days" sum="Total Allocated (Days)"/>
                <field name="taken_days" sum="Total Taken (Days)"/>
                <field name="pending_days" sum="Total Pending (Days)"/>
                <field name="remaining_days" sum="Total Remaining (Days)" class="fw-bold fs-6"
                       decoration-danger="remaining_days &lt;= 0"
                       decoration-success="remaining_days &gt; 0"/>
                <field name="virtual_remaining_days" sum="Total Available (Days)" optional="show"/>
                <field name="allocated_hours" optional="hide" sum="Total Allocated (Hours)"/>
                <field name="taken_hours" optional="hide" sum="Total Taken (Hours)"/>
                <field name="remaining_hours" optional="hide" sum="Total Remaining (Hours)"/>
                <field name="closest_allocation_expire" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <button name="action_view_employee_leaves" string="Time Off Details" type="object" icon="fa-calendar text-primary" title="View Leaves Taken"/>
                <button name="action_view_employee_allocations" string="Allocations" type="object" icon="fa-gift text-info" title="View Allocation Records"/>
            </list>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="view_hr_leave_balance_report_pivot" model="ir.ui.view">
        <field name="name">hr.leave.balance.report.pivot</field>
        <field name="model">hr.leave.balance.report</field>
        <field name="arch" type="xml">
            <pivot string="Leave Balance Pivot Analysis" sample="1" disable_linking="0">
                <field name="department_id" type="row"/>
                <field name="employee_id" type="row"/>
                <field name="holiday_status_id" type="col"/>
                <field name="allocated_days" type="measure"/>
                <field name="taken_days" type="measure"/>
                <field name="remaining_days" type="measure"/>
            </pivot>
        </field>
    </record>

    <!-- Graph View -->
    <record id="view_hr_leave_balance_report_graph" model="ir.ui.view">
        <field name="name">hr.leave.balance.report.graph</field>
        <field name="model">hr.leave.balance.report</field>
        <field name="arch" type="xml">
            <graph string="Leave Balance by Employee" type="bar" sample="1">
                <field name="employee_id"/>
                <field name="remaining_days" type="measure"/>
                <field name="taken_days" type="measure"/>
                <field name="allocated_days" type="measure"/>
            </graph>
        </field>
    </record>

    <!-- Main Window Action -->
    <record id="action_hr_leave_balance_report" model="ir.actions.act_window">
        <field name="name">Employee Leave Balances</field>
        <field name="res_model">hr.leave.balance.report</field>
        <field name="view_mode">list,pivot,graph</field>
        <field name="search_view_id" ref="view_hr_leave_balance_report_search"/>
        <field name="context">{
            'search_default_filter_active': 1,
            'search_default_group_department': 1
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No leave balance records found!
            </p>
            <p>
                Leave balances reflect approved allocations minus validated and pending time off requests per employee and leave type.
            </p>
        </field>
    </record>

    <!-- Top Menu Item in Time Off -> Reporting -->
    <menuitem id="menu_hr_leave_balance_report"
              name="Employee Leave Balances"
              parent="hr_holidays.menu_hr_holidays_report"
              action="action_hr_leave_balance_report"
              sequence="1"
              groups="hr_holidays.group_hr_holidays_user,hr_holidays.group_hr_holidays_manager"/>

</odoo>

