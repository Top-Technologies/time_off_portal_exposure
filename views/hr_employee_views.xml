<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Inherit Employee Form View to add Time Off Officer and allow Portal Users -->
    <record id="view_employee_form_inherit_time_off_portal" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.time.off.portal</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="priority">40</field>
        <field name="arch" type="xml">
            <!-- Add Time Off Officer field -->
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="time_off_officer_id" widget="many2one_avatar_user" placeholder="Select HR Time Off Officer..."/>
            </xpath>
            <!-- Allow Portal Users to be linked in Related User field -->
            <xpath expr="//page[@name='hr_settings']//field[@name='user_id']" position="attributes">
                <attribute name="domain">['|', ('company_ids', '=', False), ('company_ids', 'in', company_id)]</attribute>
            </xpath>
        </field>
    </record>

    <!-- Inherit Employee Public Form View -->
    <record id="hr_employee_public_view_form_inherit_time_off_portal" model="ir.ui.view">
        <field name="name">hr.employee.public.form.inherit.time.off.portal</field>
        <field name="model">hr.employee.public</field>
        <field name="inherit_id" ref="hr.hr_employee_public_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="time_off_officer_id" widget="many2one_avatar_user" readonly="1"/>
            </xpath>
        </field>
    </record>

</odoo>
