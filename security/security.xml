<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Portal Employee: Access Own Leave Requests -->
        <record id="hr_leave_rule_portal_employee" model="ir.rule">
            <field name="name">Portal Employee: Own Time Off Requests</field>
            <field name="model_id" ref="hr_holidays.model_hr_leave"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">[
                '|',
                ('employee_id.user_id', '=', user.id),
                ('employee_id.work_contact_id', '=', user.partner_id.id)
            ]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="True"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Portal Manager: Access Subordinates' Leave Requests -->
        <record id="hr_leave_rule_portal_manager" model="ir.rule">
            <field name="name">Portal Manager: Subordinate Time Off Requests</field>
            <field name="model_id" ref="hr_holidays.model_hr_leave"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">[
                '|',
                ('employee_id.parent_id.user_id', '=', user.id),
                ('employee_id.leave_manager_id', '=', user.id)
            ]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="True"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Portal Employee: Access Own Allocations -->
        <record id="hr_leave_allocation_rule_portal_employee" model="ir.rule">
            <field name="name">Portal Employee: Own Time Off Allocations</field>
            <field name="model_id" ref="hr_holidays.model_hr_leave_allocation"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">[
                '|',
                ('employee_id.user_id', '=', user.id),
                ('employee_id.work_contact_id', '=', user.partner_id.id)
            ]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

        <!-- Portal User: Read Visible Leave Types -->
        <record id="hr_leave_type_rule_portal" model="ir.rule">
            <field name="name">Portal: Read Visible Leave Types</field>
            <field name="model_id" ref="hr_holidays.model_hr_leave_type"/>
            <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
            <field name="domain_force">[('is_portal_visible', '=', True)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>

    </data>
</odoo>
